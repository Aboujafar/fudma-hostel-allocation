ms-center min-w-0 max-w-full"><div data-code-block-controls="true" role="presentation" class="flex items-center gap-px print:hidden flex-wrap justify-end"><span data-state="closed" class="contents"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full text-default not-disabled:not-aria-disabled:hover:bg-primary-ghost-hover data-[state=open]:bg-primary-ghost-hover border-transparent h-9 gap-1.5 border-0 px-2 py-0 text-sm leading-5 aspect-square shrink-0 items-center justify-center !px-0" aria-label="Enable word wrap" aria-pressed="false"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-c6b5375eadec3cee.svg#codex-icon-text-overflow-light-20" fill="currentColor"></use></svg></button></span><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full text-default not-disabled:not-aria-disabled:hover:bg-primary-ghost-hover data-[state=open]:bg-primary-ghost-hover border-transparent h-9 gap-1.5 border-0 px-2 py-0 text-sm leading-5 aspect-square shrink-0 items-center justify-center !px-0" aria-label="Copy code" data-state="closed"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-c6b5375eadec3cee.svg#codex-icon-square-on-square-light-20" fill="currentColor"></use></svg></button></div></div></div><div class="relative [container-type:inline-size]"><div class="InlineCodePane-EYx4bd w-full overflow-x-hidden"><div class="relative z-0 flex max-w-full Viewer-ALA646" dir="ltr"><div class="chatgpt-code-scrollport flex w-full items-stretch overscroll-x-contain Scrollport-kY3Nlm overflow-x-auto"><pre class="m-0 flex-1 cursor-text px-4 pb-3 font-mono text-size-code text-default md:px-5 ViewerContent-Cg8AgN pt-0 min-w-max whitespace-pre"><code><span class="text-codex-syntax-attribute">.title-container </span><span>{
    </span><span class="text-codex-syntax-attribute">display</span><span>: </span><span class="text-codex-syntax-literal">flex</span><span>;
    </span><span class="text-codex-syntax-attribute">align-items</span><span>: </span><span class="text-codex-syntax-literal">center</span><span>;
    </span><span class="text-codex-syntax-attribute">justify-content</span><span>: </span><span class="text-codex-syntax-literal">center</span><span>;
    </span><span class="text-codex-syntax-attribute">gap</span><span>: </span><span class="text-codex-syntax-literal">10px</span><span>;
}

</span><span class="text-codex-syntax-attribute">.fudma-logo </span><span>{
    </span><span class="text-codex-syntax-attribute">width</span><span>: </span><span class="text-codex-syntax-literal">45px</span><span>;
    </span><span class="text-codex-syntax-attribute">height</span><span>: </span><span class="text-codex-syntax-literal">45px</span><span>;
    </span><span class="text-codex-syntax-attribute">object-fit</span><span>: </span><span class="text-codex-syntax-literal">contain</span><span>;
    </span><span class="text-codex-syntax-attribute">flex-shrink</span><span>: </span><span class="text-codex-syntax-literal">0</span><span>;
}

</span><span class="text-codex-syntax-attribute">.title-container </span><span class="text-codex-syntax-name">h1 </span><span>{
    </span><span class="text-codex-syntax-attribute">margin</span><span>: </span><span class="text-codex-syntax-literal">0</span><span>;
}</span></code></pre></div></div></div><button class="group/scroll-to-bottom cursor-interaction absolute z-30 flex h-8 w-8 translate-x-1/2 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding text-secondary transition-opacity duration-basic ease-in-out end-1/2 print:hidden pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Scroll to bottom" tabindex="-1" type="button"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-c6b5375eadec3cee.svg#codex-icon-arrow-down-lg-light-20" fill="currentColor"></use></svg></button></div></div></div></div><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline="">What this does:</span></p><ul class="List-rH8nmc" data-d-component="list" data-d-marker="bullet" data-d-marker-layout="native" style="--d-list-row-gap: calc(var(--spacing, 0.25rem) * 0); gap: calc(var(--spacing, 0.25rem) * 0);"><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text">Places the logo to the left of the title.</p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text">Keeps both on the same horizontal line.</p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text">Adds a small gap between them.</p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text">Vertically aligns the logo with the title.</p></div></div></li></ul><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text">Make sure <code class="Code-kbs71c" data-d-component="code">fudma-logo.png</code> is inside your <code class="Code-kbs71c" data-d-component="code">static</code> folder.</p><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline="">Important:</span> If you already have a title section in your HTML, replace only that section instead of adding a second title. If you paste your current title HTML and its CSS here, I can show you exactly where to make the change without disturbing your existing design.</p></div></div></div></div></div></div></div></div></div></div></div></div></div><div id="_r_72l_-panel-2" aria-hidden="true" aria-labelledby="_r_72l_-option-2" role="region" inert="" class="pointer-events-none invisible absolute inset-x-0 top-0"><div class="mb-4 flex items-center gap-3 select-none"><span class="flex size-8 items-center justify-center rounded-full border border-default"><svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="size-5"><path d="M11.6475 18.3409C11.0975 18.3409 10.575 18.2364 10.08 18.0274C9.58502 17.8184 9.14502 17.5269 8.76002 17.1529C8.34202 17.2959 7.90751 17.3674 7.45651 17.3674C6.71951 17.3674 6.03751 17.1859 5.41051 16.8229C4.78351 16.4599 4.27751 15.9649 3.89251 15.3379C3.51851 14.7109 3.33151 14.0124 3.33151 13.2424C3.33151 12.9234 3.37551 12.57