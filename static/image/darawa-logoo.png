equiv="origin-trial" content="AnY33Lstn7fSTXvj63Z4glPcRXtUukuM9rLN87JGOugFyfum9ckNUU3NYHeRLcp6TELT5wbCZih5SlHfumMbJAkAAABmeyJvcmlnaW4iOiJodHRwczovL2NoYXRncHQuY29tOjQ0MyIsImZlYXR1cmUiOiJXZWJSdGNTY3RwU25hcCIsImV4cGlyeSI6MTc5NDg3MzYwMCwiaXNTdWJkb21haW4iOnRydWV9"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/426505.18ad5d9adc.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/388573.e0e237b3a2.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/278893.d7313b0c44.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/701014.7801eba529.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/359600.cbca6f1495.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/196211.efea808fba.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/516588.13b17f3696.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/131734.db5bc5e909.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/634418.a79ddcbe8e.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/794952.9acea2a57d.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/243571.1c0a5e6576.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/611373.2291e7905f.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/470125.c8ba1035d6.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/303014.a35cdd99af.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/291200.99bd252e97.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/130606.f44c07e912.css"><link rel="stylesheet" type="text/css" href="./darawa-logo_files/292421.dac6b84805.css"></head><body style="--font-ui-size: 16px; --text-4xl: 36px; --text-3xl: 30px; --text-2xl: 24px; --text-xl: 20px; --text-lg: 18px; --text-base: 16px; --text-sm: 14px; --text-xs: 12px; --text-dynamic-isle-row: 14px; --text-heading-lg: 24px; --text-heading-app: 28px; --text-heading-md: 20px; --text-heading-sm: 18px;"><script nonce="">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    claimAttachmentNotification: (expected) => {
      if (!launch || launch.snapshot !== expected || launch.attachmentNotified) return false;
      launch.attachmentNotified = true;
      save();
      return true;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();
